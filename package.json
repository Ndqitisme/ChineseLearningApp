{
  "name": "tieumai",
  "private": true,
  "version": "0.1.0",
  "description": "Ứng dụng desktop học từ vựng tiếng Trung cho người Việt, với trợ lý 3D chạy nền ở cạnh màn hình",
  "repository": "github:Ndqitisme/ChineseLearningApp",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "data:fetch": "node tools/data/fetch-sources.ts",
    "data:build": "node tools/data/build.ts",
    "data:fonts": "python tools/data/subset_font.py",
    "skin:render": "python tools/skins/run.py render",
    "skin:check": "python tools/skins/run.py check",
    "skin:save": "python tools/skins/run.py save",
    "skin:pack": "python tools/skins/run.py pack",
    "perf": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/perf/measure.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "hanzi-writer": "^3.7.3",
    "pinyin-pro": "^3.29.5",
    "pitchy": "^4.1.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "hanzi-writer-data": "^2.0.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  }
}
